# ==============================================================================
# AstroMind AI - Environment Configuration Template
# COPY TO .env FOR LOCAL DEVELOPMENT. NEVER COMMIT ACTUAL CREDENTIALS.
# ==============================================================================

# Application Environment
APP_ENV=development
APP_NAME=AstroMind AI
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# Security & CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=15
RATE_LIMIT_CALCULATION_PER_MINUTE=60
RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_REPORTS_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=120
MAX_REQUEST_BODY_BYTES=1048576
MAX_CHAT_INPUT_CHARS=8000
MAX_TOOL_CALLS_PER_TURN=5

# Database & Authentication (Supabase / PostgreSQL)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/astromind
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=PLACEHOLDER_ANON_KEY_CLIENT_SAFE
SUPABASE_SERVICE_ROLE_KEY=PLACEHOLDER_SERVICE_ROLE_KEY_SERVER_ONLY

# AI Provider Configuration (Server-Side Only - Never expose to browser)
LLM_PROVIDER=openai
LLM_API_KEY=PLACEHOLDER_LLM_KEY
LLM_MODEL=gpt-4o-mini
LLM_MAX_OUTPUT_TOKENS=1500
LLM_TIMEOUT_SECONDS=30
LLM_DAILY_BUDGET_USD=10.00

# Embeddings & Vector Search (pgvector)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Cache & Background Workers
REDIS_URL=redis://localhost:6379/0
WORKER_QUEUE_NAME=astromind-jobs

# Private Report Storage
REPORT_STORAGE_PROVIDER=local
REPORT_BUCKET=astromind-private-reports
SIGNED_URL_TTL_SECONDS=300

# Deterministic Vedic Astrology Engine
ASTROLOGY_ENGINE=pyswisseph
ASTROLOGY_ENGINE_VERSION=2.10.3
ASTROLOGY_CONFIG_VERSION=vedic-v1
ASTROLOGY_AYANAMSA=lahiri
ASTROLOGY_NODE_MODE=mean

# Observability (Optional)
ERROR_TRACKING_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
